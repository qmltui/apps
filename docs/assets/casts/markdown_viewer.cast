[0.001,"o","\u001b[?25l\u001b[?2004h\u001b[?1004h\u001b[?2031h\u001b[?1000l\u001b[?1002l\u001b[?1003l\u001b[?1006l\u001b]11;#181824\u0007\u001b[?1049h\u001b[2J\u001b[H\u001b]11;#181824\u0007\u001b[2J\u001b[H\u001b[1;1H\u001b[0m\u001b[38;2;65;69;88;48;2;32;32;48m┌──────────────────────────────────────────────────────────────────────────────────────────────────┐\u001b[2;1H│\u001b[39m \u001b[38;2;0;215;255;1m📖 Modern Style Showcase\u001b[39;22m  \u001b[38;2;65;69;88m│\u001b[39m  \u001b[38;2;98;104;128m[H:6 C:1 T:1]\u001b[39m  \u001b[38;2;65;69;88m│\u001b[39m  \u001b[38;2;255;184;108;1mLn 1/68 (1%)\u001b[39;22m  \u001b[38;2;65;69;88m│\u001b[39m  \u001b[38;2;255;121;198m[aurora : modern]\u001b[39m                \u001b[38;2;65;69;88m│\u001b[3;1H└──────────────────────────────────────────────────────────────────────────────────────────────────┘\u001b[4;1H\u001b[38;2;255;255;255;48;2;88;86;214;1m Modern Style Showcase \u001b[39;48;2;24;24;36;22m                                                                             \u001b[5;1H                                                                                                    \u001b[6;1H\u001b[38;2;226;232;240mA casual introduction. 你好世界！\u001b[39m                                                                   \u001b[7;1H                                                                                                    \u001b[8;1H                                                                                                    \u001b[9;1H\u001b[38;2;0;215;255;1m● Let’s talk about artichokes\u001b[39;22m                                                                       \u001b[10;1H                                                                                                    \u001b[11;1H\u001b[38;2;226;232;240mThe \u001b[3martichoke\u001b[23m is mentioned as a garden plant in the 8th century BC by Homer and Hesiod. The \u001b[39m        \u001b[12;1H\u001b[38;2;226;232;240mnaturally occurring variant of the artichoke, the cardoon, which is native to the Mediterranean \u001b[39m    \u001b[13;1H\u001b[38;2;226;232;240marea, also has records of use as a food among the ancient Greeks and Romans. Pliny the Elder \u001b[39m       \u001b[14;1H\u001b[38;2;226;232;240mmentioned growing of \u001b[3mcarduus\u001b[23m in Carthage and Cordoba.\u001b[39m                                               \u001b[15;1H                                                                                                    \u001b[16;1H\u001b[38;2;0;215;255;1m│ \u001b[38;2;226;232;240;22mHe holds him with a skinny hand,\u001b[39m                                                                  \u001b[17;1H\u001b[38;2;0;215;255;1m│ \u001b[38;2;226;232;240;22m‘There was a ship,’ quoth he.\u001b[39m                                                                     \u001b[18;1H\u001b[38;2;0;215;255;1m│ \u001b[38;2;226;232;240;22m‘Hold off! unhand me, grey-beard loon!’\u001b[39m                                                           \u001b[19;1H\u001b[38;2;0;215;255;1m│ \u001b[38;2;226;232;240;22mAn artichoke, dropt he.\u001b[39m                                                                           \u001b[20;1H                                                                                                    \u001b[21;1H\u001b[38;2;226;232;240m--Samuel Taylor Coleridge, The Rime of the Ancient Mariner\u001b[39m                                          \u001b[22;1H\u001b[38;2;0;215;255;4mhttps://poetryfoundation.org/poems/43997/\u001b[39;24m                                                           \u001b[23;1H                                                                                                    \u001b[24;1H                                                                                                    \u001b[25;1H\u001b[38;2;0;215;255;1m● Other foods worth mentioning\u001b[39;22m                                                                      \u001b[26;1H                                                                                                    \u001b[27;1H\u001b[38;2;255;184;108;1m1. \u001b[38;2;226;232;240;22mCarrots\u001b[39m                                                                                          \u001b[28;1H\u001b[38;2;255;184;108;1m2. \u001b[38;2;226;232;240;22mCelery\u001b[39m                                                                                           \u001b[29;1H\u001b[38;2;255;184;108;1m3. \u001b[38;2;226;232;240;22mTacos\u001b[39m                                                                                            \u001b[30;1H\u001b[38;2;65;69;88;48;2;32;32;48m┌──────────────────────────────────────────────────────────────────────────────────────────────────┐\u001b[31;1H│\u001b[39m \u001b[38;2;226;232;240;1mReady\u001b[39;22m  \u001b[38;2;65;69;88m│\u001b[39m  \u001b[38;2;98;104;128m[Tab] Section  [j/k] Scroll  [s] Style  [e] Editor  [l] Lines  [/] Find  [t] Theme  [o\u001b[39m \u001b[38;2;65;69;88m│\u001b[32;1H└──────────────────────────────────────────────────────────────────────────────────────────────────┘"]
